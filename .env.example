# ==============================================================================
# AI Quantitative Trading - Environment Configuration Template (.env.example)
# ==============================================================================
# 使用方式：複製此檔案為 `.env` 並填入對應的 API 金鑰
# 複製指令：cp .env.example .env (Linux/Mac) 或 Copy-Item .env.example .env (PowerShell)
# 注意：真實金鑰檔案 `.env` 已被 .gitignore 排除，切勿上傳公開倉庫！
# ==============================================================================

# ------------------------------------------------------------------------------
# BingX (盈幣) 官方 OpenAPI 憑證
# ------------------------------------------------------------------------------
# 取得方式：登入 BingX -> 個人中心 -> API 管理 -> 建立 API Key
# 權限要求：行情讀取 (Read)、現貨讀取、合約讀取 (若要實盤交易才需開啟 Trade)
# 預設運作：系統預設使用 dry_run=True 安全演練模式，不會向交易所發送扣款訂單
BINGX_API_KEY=your_bingx_api_key_here
BINGX_API_SECRET=your_bingx_api_secret_here

# ------------------------------------------------------------------------------
# Pionex (派網) OpenAPI 憑證 (選填)
# ------------------------------------------------------------------------------
# 取得方式：登入 Pionex -> 設定 -> API Key 管理
PIONEX_API_KEY=your_pionex_api_key_here
PIONEX_API_SECRET=your_pionex_api_secret_here

# ------------------------------------------------------------------------------
# TypeSafe AI (Jev 短線決策模型) 憑證 (選填)
# ------------------------------------------------------------------------------
# 取得方式：前往 https://typesafe.ai/ 申請 API Token
# 若未填寫，系統將自動以本地 Mock Rule-based 決策回退引擎運行，回測與測試不中斷
TYPESAFE_API_KEY=your_typesafe_api_key_here

# ------------------------------------------------------------------------------
# 雲端 AI 決策與風控 API (選填，無金鑰或響應超時自動切換高階數學確定性規則)
# ------------------------------------------------------------------------------
# 支援模式：gemini (推薦，極低延遲) | openai | deepseek | ollama | rule (純數學規則)
# 逾時門檻：若雲端 AI 響應超過此秒數，系統將在 0ms 內自動無縫切換為高階數學風控規則
AI_PROVIDER=gemini
AI_DECISION_TIMEOUT_SEC=2.0

# Google Gemini API 憑證 (推薦，開單前二選一審查，延遲約 0.5s ~ 1.0s，有免費額度)
# 取得方式：前往 https://aistudio.google.com/ 取得 API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI / DeepSeek 相容 API 憑證 (選填)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 本地 Ollama (選填，若於具備 GPU/大記憶體環境運行時使用)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ------------------------------------------------------------------------------
# 即時通訊推播 (選填，純單向 Outbound Push，不對外開 Port，未設定則安全靜音)
# ------------------------------------------------------------------------------
# Telegram Bot
# 取得方式：在 Telegram 搜尋 @BotFather 建立 Bot 取得 Token，並向 @userinfobot 取得個人 Chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LINE Messaging API (官方長期支援 Push API)
# 取得方式：前往 LINE Developers Console 建立 Messaging API Channel 取得 Channel Access Token 與個人 User ID
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_USER_ID=your_line_user_id_here
# LINE_NOTIFY_TOKEN=your_legacy_line_notify_token_here (選填相容)

# ------------------------------------------------------------------------------
# 系統全局執行環境 (可選)
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
